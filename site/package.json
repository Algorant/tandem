{
  "name": "tandem-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "bun run sync:docs",
    "dev": "astro dev --force",
    "prestart": "bun run sync:docs",
    "start": "astro dev --force",
    "prebuild": "bun run sync:docs",
    "build": "astro build --force",
    "check:links": "node scripts/check-links.mjs dist",
    "check:docs": "bun run build && bun run check:links",
    "preview": "astro preview",
    "sync:docs": "node scripts/sync-docs.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.2.0",
    "astro-expressive-code": "^0.44.1",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "svgo": "4.0.2"
  }
}
